# MongoDB connection string. Local/Docker: mongodb://localhost:27017/musicplaylist
DATABASE_URI=''
# Signing key for 300-second access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=''
# Signing key for 1-day refresh tokens. Must be a DIFFERENT value from the one above.
REFRESH_TOKEN_SECRET=''
# Gmail address that sends account-verification email.
EMAIL_USERNAME=''
# Gmail APP PASSWORD for that account (not the normal account password).
PASSWORD=''
